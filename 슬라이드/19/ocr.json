00002, "h": 0.03542922326617026, "text": "• 코티솔 결핍 증상을 완화하는 최저용량을 투여", "w": 0.325}, {"conf": 1, "y": 0.6704946993658999, "x": 0.07916666682657897, "h": 0.03538765418655876, "text": "• 일반적으로 Hydrocortisone 15~25mg을 하루 2~3회로 나누어 복용", "w": 0.49583332061767577}, {"conf": 0.5, "y": 0.7125256678530756, "x": 0.08284885087975788, "h": 0.034907597113835176, "text": "• 하루 용량의 2/3은 아침 기상 후 복용, 나머지는 취침 4~6시간 전에 복용", "w": 0.4941860198974609}, {"conf": 1, "y": 0.7535335690852133, "x": 0.0537790757050743, "h": 0.02675390496270813, "text": "> Mineralocorticoid 보충", "w": 0.20639533996582032}, {"conf": 1, "y": 0.792402826616172, "x": 0.08284883729416351, "h": 0.02484563298444442, "text": "• 일차부신부전에서 필요", "w": 0.1744186019897461}, {"conf": 1, "y": 0.8233215544510039, "x": 0.0791666606250002, "h": 0.03550197378906683, "text": "• Fludrocortisone 50~200mcg 아침에 1회 복용", "w": 0.3625}, {"conf": 1, "y": 0.8576100358281447, "x": 0.9460268280435892, "h": 0.02194625328791866, "text": "13/20", "w": 0.036725413799285955}]}, {"width": 1600, "file": "p014.webp", "height": 1132, "lines": [{"conf": 1, "y": 0.11909650875924671, "x": 0.01598838146726614, "h": 0.03726391573255561, "text": "02 부신기능 저하증의 약물 요법", "w": 0.3052325439453125}, {"conf": 1, "y": 0.19257950490518838, "x": 0.029069775896162397, "h": 0.04151943462897534, "text": "+ 부신 위기(adrenal crisis, 급성부신부전)", "w": 0.3633720779418945}, {"conf": 1, "y": 0.23498233173704897, "x": 0.04999999312500023, "h": 0.035605902385374755, "text": "> 생존을 위협하는 응급상황으로 즉각적인 치료가 필요함", "w": 0.4125}, {"conf": 0.5, "y": 0.27647058979914485, "x": 0.05000000597954667, "h": 0.03536686543441081, "text": "> 증상:저혈압, 메스꺼움, 구토, 발열, 피로, 의식상실 등", "w": 0.40416664123535156}, {"conf": 0.5, "y": 0.3193107575569136, "x": 0.055087026861476505, "h": 0.028729614015181593, "text": "> 응급처치", "w": 0.0904073429107666}, {"conf": 1, "y": 0.3630742045457396, "x": 0.08284883759148176, "h": 0.02501614439192601, "text": "• Hydrocortisone", "w": 0.14534883499145507}, {"conf": 1, "y": 0.39399293237092003, "x": 0.10416667470669197, "h": 0.035418830575033144, "text": "✓ Hydrocortisone 100mg bolus 주사", "w": 0.2916666603088379}, {"conf": 1, "y": 0.43286219022063976, "x": 0.10755812938749103, "h": 0.02915194346289751, "text": "✓ 이후 24시간 동안 hydrocortisone 200mg을 연속으로 주입 (혹은 6시간마다 50mg을 bolus)", "w": 0.6598837280273437}, {"conf": 0.5, "y": 0.46996466367983114, "x": 0.10901163868141346, "h": 0.035335689045936425, "text": "✓ 이후 1~3일에 걸쳐 감량하고, 경구유지용량으로 전환", "w": 0.3677325439453125}, {"conf": 1, "y": 0.5086108785280024, "x": 0.05513405658345778, "h": 0.03000616943035861, "text": "> 응급처치", "w": 0.09031328201293946}, {"conf": 1, "y": 0.5521201414540335, "x": 0.08430232987046345, "h": 0.021201413427561766, "text": "O Fluid resuscitation", "w": 0.1656976699829102}, {"conf": 0.5, "y": 0.5821554765539058, "x": 0.10416666476060683, "h": 0.035491581097929714, "text": "✓ 0.9% saline 또는 5% dextrose in 0.9% saline 1L 1시간 동안 투여", "w": 0.49583332061767577}, {"conf": 1, "y": 0.6219081267377947, "x": 0.10901163575701034, "h": 0.029151943462897623, "text": "✓ Hyponatremia를 피하기 위해 hypotonic saline은 피하도록 함", "w": 0.4534883499145508}, {"conf": 1, "y": 0.8582070383758847, "x": 0.9447397629865644, "h": 0.018698859130535928, "text": "14/20", "w": 0.036392567157745415}]}, {"width": 1600, "file": "p015.webp", "height": 1132, "lines": [{"conf": 1, "y": 0.4117709578217156, "x": 0.3966977455131385, "h": 0.047094634901929555, "text": "Lesson 03", "w": 0.2036975288391113}, {"conf": 1, "y": 0.5051334711703228, "x": 0.22529069356550352, "h": 0.0924024615607919, "text": "부신피질호르몬의 투여", "w": 0.5479651260375977}]}, {"width": 1600, "file": "p016.webp", "height": 1132, "lines": [{"conf": 1, "y": 0.11909651004303101, "x": 0.014534889584232307, "h": 0.03903069849991547, "text": "03 부신피질호르몬의 투여", "w": 0.2558139419555664}, {"conf": 1, "y": 0.19507186894734463, "x": 0.030523256266276336, "h": 0.02464065619155298, "text": "+", "w": 0.018895348310470576}, {"conf": 1, "y": 0.19507186926038844, "x": 0.0523255738857