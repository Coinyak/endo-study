958148107090608, "text": "근골격계", "w": 0.06703777313232422}, {"conf": 1, "y": 0.7063655023830459, "x": 0.3473837259501677, "h": 0.039217536104020345, "text": "골다공증, 골괴사, 근병증", "w": 0.17732557296752932}, {"conf": 1, "y": 0.8125014124797273, "x": 0.3472752811671127, "h": 0.0382415279482784, "text": "녹내장, 백내장", "w": 0.10777502059936522}, {"conf": 1, "y": 0.8559980797481672, "x": 0.9446918411099565, "h": 0.023116775620531382, "text": "16/20", "w": 0.03939538717269897}]}, {"width": 1600, "file": "p017.webp", "height": 1132, "lines": [{"conf": 1, "y": 0.11909650879615019, "x": 0.014534888208263333, "h": 0.03903070018485244, "text": "03 부신피질호르몬의 투여", "w": 0.2558139419555664}, {"conf": 0.30000001192092896, "y": 0.1581108831517548, "x": 0.018895349154689694, "h": 0.016800777650974652, "text": "_@", "w": 0.028057775497436526}, {"conf": 1, "y": 0.19257950454007666, "x": 0.027616274642234623, "h": 0.03356890459363959, "text": "+ Glucocorticoid 복약상담", "w": 0.24709302902221678}, {"conf": 1, "y": 0.27296819778561554, "x": 0.11918605427529975, "h": 0.030933238592248946, "text": "서서히 감량하여 중단해야 하므로 의사의 지시 없이 임의로 용량을 바꾸거나 중단하면 안됩니다.", "w": 0.5901162719726563}, {"conf": 1, "y": 0.358657244057352, "x": 0.18333334542032872, "h": 0.03546040302451847, "text": "장기투여하는 경우, glucocorticoid 복용정보가 적힌 카드를 소지합니다.", "w": 0.45833332061767573}, {"conf": 1, "y": 0.44964664257718545, "x": 0.12209302052924585, "h": 0.032899558333541856, "text": "수술이나 입원이 필요한 질환이 생긴 경우, glucocorticoid의 복용량을 늘려야할 수 있습니다.", "w": 0.5843023300170899}, {"conf": 1, "y": 0.5397526498646894, "x": 0.08139534957147643, "h": 0.024929074432319176, "text": "위장장애", "w": 0.05813953399658203}, {"conf": 1, "y": 0.5397526509585999, "x": 0.17151161866023584, "h": 0.03356890459363959, "text": "• 위장장애가 나타날 수 있으며, 이러한 경우 음식과 함께 복용할 수 있습니다.", "w": 0.4811046600341797}, {"conf": 1, "y": 0.6242299798097677, "x": 0.09593023328379253, "h": 0.025063306619758752, "text": "감염", "w": 0.030523254871368408}, {"conf": 1, "y": 0.617491166748489, "x": 0.17083333239949566, "h": 0.035450010333381354, "text": "• 약으로 인해 감염에 취약해질 수 있으므로 사람이 많은 곳을 피하고 개인 위생에 신경 씁니다.", "w": 0.5833333206176758}, {"conf": 1, "y": 0.7084188915140798, "x": 0.09593023322020242, "h": 0.024796656079511314, "text": "백신", "w": 0.03052325487136842}, {"conf": 0.5, "y": 0.708418891318266, "x": 0.17296512031174302, "h": 0.026694045049984072, "text": "• 이 약을 복용하는 동안은 생백신을 투여 받으면 안됩니다.", "w": 0.3677325439453125}, {"conf": 1, "y": 0.7905544150373429, "x": 0.08866279130028505, "h": 0.026694045049984183, "text": "당대사", "w": 0.04360465049743652}, {"conf": 1, "y": 0.7905544160715342, "x": 0.1715116387024493, "h": 0.031000354685968734, "text": "• 혈당수치를 변화시킬 수 있으므로 당뇨가 있는 경우 더 자주 혈당검사를 합니다.", "w": 0.5058139419555665}, {"conf": 1, "y": 0.8521560569335405, "x": 0.9433139546061731, "h": 0.028747433908415387, "text": "1720", "w": 0.04215116024017329}]}, {"width": 1600, "file": "p018.webp", "height": 1132, "lines": [{"conf": 1, "y": 0.12102473548533621, "x": 0.014534887888495884, "h": 0.035335689045936314, "text": "03 부신피질호르몬의 투여", "w": 0.25581394195556645}, {"conf": 1, "y": 0.1925795045041424, "x": 0.027616280816508514, "h": 0.03356890459363948, "text": "+ Glucocorticoid 투여의 중단", "w": 0.2688953399658203}, {"conf": 1, "y": 0.24204946969731955, "x": 0.05377906324216859, "h": 0.031051145425533666, "text": "> 장기간 Glucocorticoid 투여로 인해 HPA축이 억제될 수 있음", "w": 0.4636627960205078}, {"conf": 1, "y": 0.283367556043739, "x": 0.082848841555999, "h": 0.028747433908415276, "text": "• Glucocorticoid를 경구나 주사로 투여했을 때 발생", "w": 0.361918601989746}, {"conf": 1, "y": 0.3176470603873802, "x": 0.07916666726060675, "h": 0.03570982929674549, "text": "• 오래 투여할수록, 용량이 많을수록 위험도가 높음", "w": 0.3458333206176758}, {"conf": 0.5, "y": 0.3630742049364294, "x": 0.05377907559696176, "h": 0.039752650176678395, "text": "> Glucocorticoid 유발 부신부전을 고려, 적절한 감량요법을 시행해야 함", "w": 0.5247092819213868}, {"conf": 1, "y": 0.4086242310484336, "x": 0.055232561295620285, "h": 0.030800819396972656, "text": "> 일반적으로 10~30%씩 안정적으로 감량하면서 환자의 임상반응을 모니터링", "w": 0.5595930099487305}, {"conf": 1, "y": 0.8583162223945189, "x": 0.9462209305642948, "h": 0.020659042331439448, "text": "18/20", "w": 0.036337208747863725}]}, {"width": 1600, "file": "p019.webp", "height": 1132, "lines": [{"conf": 1, "y": 0.11909650995941157, "x": 0.013081398178171603, "h": 0.043447659630657554, "text": "부신 기능 장애와 약물 요법", "w": 0.27325580596923826}, {"conf": 1, "y": 0.1680863867103235, "x": 0.0711568234082123, "h": 0.0703980678383116, "text": "학습정리", "w": 0.15855844497680663}, {"conf": 0.5, "y": 0.31622176691839665, "x": 0.055232558008695615, "h": 0.049281312383105846, "text": "1", "w": 0.034883720874786375}, {"conf": 1, "y": 0.3568904590858061, "x": 0.09447673911473473, "h": 0.04593639575971731, "text": "부신기능항진증에서 수술이 불가능하거나 효과가 없는 경우, 여러가지 기전의 약물을", "w": 0.7572674560546875}, {"conf": 1, "y": 0.39835728921452795, "x": 0.0930232563624537, "h": 0.039014374830697696, "text": "사용할 수 있다.", "w": 0.14389534950256347}, {"conf": 0.5, "y": 0.46611909669699325, "x": 0.05377906998108266, "h": 0.05133470124153705, "text": "2", "w": 0.03633720874786377}, {"conf": 1, "y": 0.5112936348738538, "x": 0.09302327383455988, "h": 0.043476682669703615, "text": "부신기능저하증은 glucocorticoid나 mineralocorticoid로 치료하며, 장기치료하는 경우", "w": 0.8183139038085937}, {"conf": 1, "y": 0.5503080079003596, "x": 0.09302325903639684, "h": 0.039014374830697474, "text": "환자교육이 중요하다.", "w": 0.19912790298461913}, {"conf": 0.5, "y": 0.6221765923617418, "x": 0.055232558251596654, "h": 0.049281312383105846, "text": "③", "w": 0.036337208747863774}, {"conf": 1, "y": 0.6837455829107357, "x": 0.0930232624261901, "h": 0.039047025539007296, "text": "부신위기(adrenal crisis)는 즉시 치료를 시작해야 하는 응급 상황이다.", "w": 0.6453488159179689}]}, {"width": 1600, "file": "p020.webp", "height": 1132, "lines": [{"conf": 1, "y": 0.11909650858054444, "x": 0.013081400583034117, "h": 0.03903070018485244, "text": "부신 기능 장애와 약물 요법", "w": 0.27325580596923826}, {"conf": 1, "y": 0.16894753147710273, "x": 0.069470